# ─── Database ──────────────────────────────────────────────────────────────────
POSTGRES_USER=ellybear
POSTGRES_PASSWORD=ellybear_secret
POSTGRES_DB=ellybear_pos
DATABASE_URL=postgresql://ellybear:ellybear_secret@localhost:5432/ellybear_pos

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis_secret
REDIS_URL=redis://:redis_secret@localhost:6379

# ─── JWT ───────────────────────────────────────────────────────────────────────
JWT_SECRET=supersecretjwtkey_change_in_production_min32chars
JWT_REFRESH_SECRET=supersecretrefreshkey_change_in_production_min32chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── App ───────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000

# ─── Storage (S3-compatible) ───────────────────────────────────────────────────
STORAGE_PROVIDER=local         # local | s3 | gcs
AWS_S3_BUCKET=ellybear-assets
AWS_S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Frontend ──────────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=ws://localhost:4000
NEXT_PUBLIC_APP_NAME=Ellybear POS

# ─── Integrations (optional) ───────────────────────────────────────────────────
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SENDGRID_API_KEY=
