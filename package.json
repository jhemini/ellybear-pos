{
  "name": "ellybear-pos",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "yarn workspaces run dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "lint": "yarn workspaces run lint",
    "db:generate": "yarn workspace @ellybear/backend db:generate",
    "db:migrate": "yarn workspace @ellybear/backend db:migrate",
    "db:seed": "yarn workspace @ellybear/backend db:seed",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.10.2",
    "prettier": "^3.4.2",
    "tailwindcss": "^4"
  },
  "engines": {
    "node": ">=20.0.0",
    "yarn": ">=1.22.0"
  }
}
